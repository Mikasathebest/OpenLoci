# Node.js 24+. The default vault is outside the repository.
# OPENLOCI_VAULT=/absolute/path/to/private-vault
# Default: SQLite at <vault>/.openloci/index.sqlite.
# Set DATABASE_URL for PostgreSQL. Never commit database passwords.
# DATABASE_URL=postgresql://openloci:password@localhost:5432/openloci
# Prefer a provider URL with verified TLS; supply its CA if needed.
# PGSSLROOTCERT=/absolute/path/to/provider-ca.pem
PORT=4310
OPENLOCI_TIMEZONE=Asia/Shanghai
# Optional config path. Default: <vault>/.openloci/mcp.json
# OPENLOCI_MCP_CONFIG=/absolute/path/to/mcp.json
# OAuth desktop credentials for the community Google Calendar MCP server.
# GOOGLE_OAUTH_CREDENTIALS=/absolute/path/to/gcp-oauth.keys.json
