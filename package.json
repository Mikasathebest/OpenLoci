{
  "name": "openloci",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown personal memory with SQLite, PostgreSQL and MCP integrations",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.2",
    "leaflet": "1.9.4",
    "mailparser": "3.12.4",
    "marked": "17.0.1",
    "mcp-remote": "0.15.2",
    "pg": "8.16.3",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "jsdom": "30.1.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
